# Copy to .env. Plain KEY=value lines (the Makefile includes this file), no quotes.
# Booleans are exactly true or false.
PORT=8080
APP_ENV=development
APP_URL=http://localhost:3000
# Production: sslmode is required (verify-full recommended); APP_URL and S3_ENDPOINT must be https.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/boilerplate_go?sslmode=disable
# At least 32 characters or the service refuses to start; production also refuses "change-me".
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_AUTH_PER_MINUTE=10
# Reverse proxies in front of the app. 0 ignores X-Forwarded-For; N uses its N-th entry from the right.
TRUSTED_PROXY_HOPS=0
# Required when TRUSTED_PROXY_HOPS > 0: X-Forwarded-For is only honoured from these peers.
TRUSTED_PROXY_CIDRS=
# Minimum gap between two emails of the same type to the same user (0 disables).
EMAIL_TOKEN_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000
# Empty SMTP_HOST logs emails (with their one-time links) instead of sending them: dev only,
# the service refuses to start without SMTP_HOST when APP_ENV=production. Mailpit: localhost / 1025.
SMTP_HOST=localhost
# 465 = implicit TLS; any other port = STARTTLS (mandatory in production, opportunistic in development).
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# R2: https://<account_id>.r2.cloudflarestorage.com ; MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=boilerplate
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
