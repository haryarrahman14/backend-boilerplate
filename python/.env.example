PORT=8080
APP_ENV=development
# must be https:// in production (links carry one-time tokens)
APP_URL=http://localhost:3000
# sslmode: disable | require | verify-ca | verify-full (system trust store, or sslrootcert=<file>);
# production refuses a URL without an explicit sslmode, verify-full recommended
DATABASE_URL=postgres://postgres:postgres@localhost:5433/boilerplate_python?sslmode=disable
# at least 32 characters, used byte for byte; production refuses any value still containing "change-me"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# booleans are exactly true / false
AUTH_REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_AUTH_PER_MINUTE=10
# reverse proxies in front of the app; N -> client IP is the N-th X-Forwarded-For entry from the right, 0 -> socket peer
TRUSTED_PROXY_HOPS=0
# comma-separated CIDRs of those proxies; required when TRUSTED_PROXY_HOPS > 0, X-Forwarded-For from anyone else is ignored
TRUSTED_PROXY_CIDRS=
# minimum gap between two emails of the same type to the same user; 0 disables
EMAIL_TOKEN_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000
# empty -> emails (with their one-time links) are logged instead of sent; development only,
# the service refuses to start with an empty SMTP_HOST when APP_ENV=production
SMTP_HOST=localhost
# 465 -> implicit TLS; any other port -> STARTTLS (mandatory in production, opportunistic in development)
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# must be https:// in production
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=boilerplate
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
