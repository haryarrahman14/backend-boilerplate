# Copy to .env and adjust. Names and defaults are identical across all four implementations (SPEC.md section 2).
PORT=8080
APP_ENV=development
# Must be https:// in production (email links carry one-time tokens).
APP_URL=http://localhost:3000
# Production must set sslmode explicitly: disable | require | verify-ca | verify-full (recommended).
# Private CA: add &sslrootcert=/path/to/ca.crt (read by the app and by `make migrate`).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/boilerplate_nestjs?sslmode=disable
# At least 32 characters, used byte for byte; production refuses this placeholder. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_AUTH_PER_MINUTE=10
# Number of reverse proxies in front of the app. 0: client IP = socket peer, X-Forwarded-For ignored.
# N: the N-th X-Forwarded-For entry from the right (the left side is client-controlled).
TRUSTED_PROXY_HOPS=0
# Comma-separated CIDRs of those proxies, required when TRUSTED_PROXY_HOPS > 0; X-Forwarded-For from any
# other peer is ignored. e.g. 10.0.0.0/8,::1/128
TRUSTED_PROXY_CIDRS=
# Minimum gap between two verification / reset emails to the same user; 0 disables.
EMAIL_TOKEN_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000
# Empty SMTP_HOST logs emails (with their one-time links) instead of sending them: development only,
# startup refuses APP_ENV=production without it. Local Mailpit: SMTP_HOST=localhost, UI on :8025
SMTP_HOST=
# 465: implicit TLS. Other ports: STARTTLS, mandatory in production, opportunistic in development.
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com (https:// required in production). Local MinIO below.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=boilerplate
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
