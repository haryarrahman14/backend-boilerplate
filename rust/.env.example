PORT=8080
APP_ENV=development
# Must be https:// in production.
APP_URL=http://localhost:3000
# Production requires an explicit sslmode (disable | require | verify-ca | verify-full; verify-full
# recommended, checked against the system CA store unless sslrootcert is given).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/boilerplate_rust
# At least 32 characters, used byte for byte; APP_ENV=production refuses any value containing change-me.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REQUIRE_VERIFIED_EMAIL=false
RATE_LIMIT_AUTH_PER_MINUTE=10
# Reverse proxies in front of the app: 0 = use the socket peer and ignore X-Forwarded-For,
# N = take the N-th X-Forwarded-For entry from the right (the left side is client-written).
TRUSTED_PROXY_HOPS=0
# Required when TRUSTED_PROXY_HOPS > 0 (max 32): X-Forwarded-For is honoured only from these peers.
TRUSTED_PROXY_CIDRS=
# Minimum gap between two emails of the same type to the same user; 0 disables.
EMAIL_TOKEN_COOLDOWN_SECONDS=60
CORS_ORIGINS=http://localhost:3000
# Empty SMTP_HOST logs emails (to, subject, body) instead of sending them; development only:
# the service refuses to start with an empty SMTP_HOST when APP_ENV=production.
SMTP_HOST=localhost
# 465 = implicit TLS; any other port = STARTTLS with the server name verified, required in
# production (the send fails instead of going plaintext), opportunistic in development. 10 s timeout.
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com
# Must be https:// in production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=boilerplate
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
